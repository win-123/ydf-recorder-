{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yonyougov.example/schemas/gov-ydfdev-browser-dsl.schema.json",
  "title": "ydf-browser DSL Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite", "cases"],
  "properties": {
    "suite": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "name", "tenant"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tenant": { "type": "string", "minLength": 1 },
        "default_org": { "type": "string" },
        "on_case_failure": { "enum": ["continue", "stop_suite", "stop_run"] }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["code", "name", "steps"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "user": { "type": "string" },
          "default_org": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/step" }
          }
        }
      }
    }
  },
  "$defs": {
    "multiSelectExactAssignmentValue": {
      "if": { "type": "array" },
      "then": { "uniqueItems": true }
    },
    "step": {
      "type": "object",
      "oneOf": [
        {
          "required": ["action", "menu_path"],
          "properties": {
            "action": { "const": "open_menu" },
            "menu_path": { "type": "string", "minLength": 1 }
          }
        },
        {
          "required": ["component", "operation", "target"],
          "properties": {
            "component": {
              "enum": [
                "tree",
                "tab",
                "toolbar",
                "table_row_action",
                "table_row_selection",
                "action",
                "form",
                "popup_reference",
                "query",
                "table",
                "editable_table",
                "transfer_dialog",
                "dialog",
                "attachment",
                "bpr",
                "amount_unit",
                "import",
                "notification",
                "workflow_result",
                "workflow_panel"
              ]
            },
            "operation": { "type": "string", "minLength": 1 },
            "target": { "type": "object" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "component": { "const": "workflow_panel" } },
                "required": ["component"]
              },
              "then": {
                "properties": {
                  "operation": { "const": "click" },
                  "target": { "$ref": "#/$defs/workflowPanelClickTarget" }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "component": { "const": "tree" },
                  "operation": { "const": "select" }
                },
                "required": ["component", "operation"]
              },
              "then": {
                "properties": {
                  "target": { "$ref": "#/$defs/treeSelectTarget" }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "component": { "const": "bpr" },
                  "operation": { "enum": ["start", "stop"] }
                },
                "required": ["component", "operation"]
              },
              "then": {
                "properties": {
                  "target": { "$ref": "#/$defs/bprTarget" }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "component": { "const": "editable_table" },
                  "operation": { "const": "fill_row" }
                },
                "required": ["component", "operation"]
              },
              "then": {
                "properties": {
                  "target": { "$ref": "#/$defs/editableTableFillRowTarget" }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "component": { "const": "query" },
                  "operation": { "const": "search" }
                },
                "required": ["component", "operation"]
              },
              "then": {
                "properties": {
                  "target": { "$ref": "#/$defs/querySearchTarget" }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "component": { "const": "query" },
                  "operation": { "const": "reset" }
                },
                "required": ["component", "operation"]
              },
              "then": {
                "properties": {
                  "target": { "$ref": "#/$defs/queryResetTarget" }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "component": { "const": "form" },
                  "operation": { "const": "fill" }
                },
                "required": ["component", "operation"]
              },
              "then": {
                "properties": {
                  "target": { "$ref": "#/$defs/formFillTarget" }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "component": { "const": "form" },
                  "operation": { "const": "capture_values" }
                },
                "required": ["component", "operation"]
              },
              "then": {
                "properties": {
                  "target": { "$ref": "#/$defs/formCaptureValuesTarget" }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "component": { "const": "table" },
                  "operation": { "const": "capture_row_values" }
                },
                "required": ["component", "operation"]
              },
              "then": {
                "properties": {
                  "target": { "$ref": "#/$defs/tableCaptureRowValuesTarget" }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "component": { "const": "table" },
                  "operation": { "const": "click_cell_link" }
                },
                "required": ["component", "operation"]
              },
              "then": {
                "properties": {
                  "target": { "$ref": "#/$defs/tableClickCellLinkTarget" }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "component": { "const": "workflow_result" },
                  "operation": { "const": "assert" }
                },
                "required": ["component", "operation"]
              },
              "then": {
                "properties": {
                  "target": { "$ref": "#/$defs/workflowResultAssertTarget" }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "component": { "const": "workflow_result" },
                  "operation": { "const": "details" }
                },
                "required": ["component", "operation"]
              },
              "then": {
                "properties": {
                  "target": { "$ref": "#/$defs/workflowResultDetailsTarget" }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "component": { "const": "workflow_result" },
                  "operation": { "const": "confirm" }
                },
                "required": ["component", "operation"]
              },
              "then": {
                "properties": {
                  "target": { "$ref": "#/$defs/workflowResultConfirmTarget" }
                }
              }
            }
          ]
        }
      ]
    },
    "bprTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "querySearchTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions"],
      "properties": {
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/queryCondition" }
        },
        "button": { "type": "string", "minLength": 1, "not": { "const": "重置" } }
      }
    },
    "queryResetTarget": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "queryCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "equals"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "equals": { "$ref": "#/$defs/multiSelectExactAssignmentValue" }
      }
    },
    "formFillTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": { "$ref": "#/$defs/formFillFields" },
        "values": { "$ref": "#/$defs/formFillFields" },
        "field": { "type": "string", "minLength": 1 },
        "equals": { "$ref": "#/$defs/multiSelectExactAssignmentValue" }
      },
      "anyOf": [
        { "required": ["fields"] },
        { "required": ["values"] },
        { "required": ["field", "equals"] }
      ]
    },
    "formFillFields": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/multiSelectExactAssignmentValue" }
        },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/queryCondition" }
        }
      ]
    },
    "treeSelectTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "node": { "enum": ["root", "first_leaf"] },
        "name": { "type": "string", "minLength": 1 },
        "component_name": { "type": "string", "minLength": 1 },
        "component_label": { "type": "string", "minLength": 1 },
        "region_label": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        {
          "required": ["node"],
          "not": {
            "anyOf": [
              { "required": ["label"] },
              { "required": ["labels"] },
              { "required": ["values"] }
            ]
          }
        },
        {
          "anyOf": [
            { "required": ["label"] },
            { "required": ["labels"] },
            { "required": ["values"] }
          ],
          "not": { "required": ["node"] }
        }
      ]
    },
    "formCaptureValuesTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture"],
      "properties": {
        "capture": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^{}\\s=]+$",
            "not": { "pattern": "^random(?:\\.|$)" }
          },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tableCaptureRowValuesTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "capture"],
      "properties": {
        "table": { "type": "string", "minLength": 1 },
        "table_name": { "type": "string", "minLength": 1 },
        "match": { "$ref": "#/$defs/rowMatch" },
        "capture": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^{}\\s=]+$",
            "not": { "pattern": "^random(?:\\.|$)" }
          },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tableClickCellLinkTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column"],
      "properties": {
        "table": { "type": "string", "minLength": 1 },
        "table_name": { "type": "string", "minLength": 1 },
        "match": { "$ref": "#/$defs/rowMatch" },
        "row_number": { "type": "integer", "minimum": 1 },
        "row_index": { "type": "integer", "minimum": 1 },
        "first_available": { "type": "boolean" },
        "select_first_available": { "type": "boolean" },
        "column": { "type": "string", "minLength": 1 },
        "link_text": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["match"] },
        { "required": ["row_number"] },
        { "required": ["row_index"] },
        { "required": ["first_available"] },
        { "required": ["select_first_available"] }
      ]
    },
    "workflowPanelClickTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "pattern": "\\S" }
      }
    },
    "workflowResultAssertTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "succeeded": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "contains": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["total"] },
        { "required": ["succeeded"] },
        { "required": ["failed"] }
      ]
    },
    "workflowResultDetailsTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "workflowResultConfirmTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "editableTableFillRowTarget": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "table": { "type": "string", "minLength": 1 },
        "row_number": { "type": "integer" },
        "row_index": { "type": "integer" },
        "fields": { "$ref": "#/$defs/editableTableFields" },
        "values": { "$ref": "#/$defs/editableTableFields" },
        "field": { "type": "string", "minLength": 1 },
        "equals": { "$ref": "#/$defs/multiSelectExactAssignmentValue" }
      },
      "anyOf": [
        { "required": ["fields"] },
        { "required": ["values"] },
        { "required": ["field", "equals"] }
      ]
    },
    "editableTableFields": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/editableTableFieldValue" }
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["field"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "column_group": { "$ref": "#/$defs/columnGroup" },
              "value": { "$ref": "#/$defs/multiSelectExactAssignmentValue" },
              "equals": { "$ref": "#/$defs/multiSelectExactAssignmentValue" }
            },
            "anyOf": [
              { "required": ["value"] },
              { "required": ["equals"] }
            ]
          }
        }
      ]
    },
    "editableTableFieldValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["column_group"],
          "properties": {
            "column_group": { "$ref": "#/$defs/columnGroup" },
            "value": { "$ref": "#/$defs/multiSelectExactAssignmentValue" },
            "equals": { "$ref": "#/$defs/multiSelectExactAssignmentValue" }
          },
          "anyOf": [
            { "required": ["value"] },
            { "required": ["equals"] }
          ]
        },
        true
      ]
    },
    "columnGroup": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "rowMatch": {
      "type": "object",
      "additionalProperties": true,
      "oneOf": [
        {
          "required": ["column", "equals"],
          "properties": {
            "column": { "type": "string", "minLength": 1 }
          }
        },
        {
          "required": ["field", "equals"],
          "properties": {
            "field": { "type": "string", "minLength": 1 }
          }
        },
        {
          "required": ["conditions"],
          "properties": {
            "conditions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/rowMatchCondition" }
            }
          }
        }
      ]
    },
    "rowMatchCondition": {
      "type": "object",
      "additionalProperties": true,
      "oneOf": [
        {
          "required": ["column", "equals"],
          "properties": {
            "column": { "type": "string", "minLength": 1 }
          }
        },
        {
          "required": ["field", "equals"],
          "properties": {
            "field": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
